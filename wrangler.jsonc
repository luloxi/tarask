{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker, D1 and R2 bucket keep the old internal names on purpose.
  "name": "cuentix",
  "account_id": "124b4210ff80c15610ed109083a5cf95",
  "main": "worker/entry.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "routes": [{ "pattern": "tarask.lulox.com.ar", "custom_domain": true }, { "pattern": "cuentix.lulox.com.ar", "custom_domain": true }],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "RECEIPTS",
      "bucket_name": "cuentix-receipts"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cuentix",
      "database_id": "8e01c6ca-8f0d-4753-9eb6-a745963bfc87",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://tarask.lulox.com.ar",
    "AUTH_URL": "https://tarask.lulox.com.ar",
    // Besides lucianoolivabianco@gmail.com (always allowed): each of these signs in with Google and gets their own empty Tarask.
    "ALLOWED_EMAILS": "lulox.eth@gmail.com,kathonejo@gmail.com",
    "SERPIX_SYNC_URL": "https://erp.lulox.com.ar/api/integrations/cuentix/events"
  },
  "observability": { "enabled": true }
}
